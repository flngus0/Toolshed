{
	"schemaVersion": 1,
	"id": "toolshed",
	"version": "${version}",
	"name": "Toolshed",
	"description": "Various skins for different tools!",
	"authors": [
		"flingus"
	],
	"contact": {
      "sources": "https://github.com/flngus0/Toolshed",
      "issues": "https://github.com/flngus0/Toolshed/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/toolshed/icon.png",
